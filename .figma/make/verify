#!/bin/bash
set -e

HEALTHCHECK_ENDPOINT='http://localhost:3000'
MAX_WAIT=90
INTERVAL=3
ELAPSED=0

echo "Waiting for dev server at $HEALTHCHECK_ENDPOINT ..."

while [ $ELAPSED -lt $MAX_WAIT ]; do
  if curl -sf -o /dev/null "$HEALTHCHECK_ENDPOINT"; then
    echo "Dev server is up."
    exit 0
  fi
  sleep $INTERVAL
  ELAPSED=$((ELAPSED + INTERVAL))
done

echo "Error: Dev server did not start within ${MAX_WAIT}s"
exit 1
