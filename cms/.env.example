# Figma Project ID (CMS Resource ID)
FIGMA_PROJECT_ID=

# Environment name (e.g., production, staging)
FIGMA_ENVIRONMENT_NAME=production

# LiveKit (realtime A/V). Server-side only — the API secret must never reach the
# browser. Get these from the LiveKit Cloud dashboard (Project → Settings → Keys).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
